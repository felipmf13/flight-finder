# Skyscanner (primary provider — no key required)
# Override locale/market if you want prices in a specific regional context.
# UK+en-GB tends to show EUR/GBP prices for European routes.
SKYSCANNER_LOCALE=en-GB
SKYSCANNER_MARKET=UK

# Duffel — https://duffel.com
# Create an account and generate an access token from the dashboard.
# Sandbox tokens start with "duffel_test_".
DUFFEL_ACCESS_TOKEN=

# Amadeus for Developers — https://developers.amadeus.com
# ⚠ Self-service portal being decommissioned July 17, 2026.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# AviationStack — https://aviationstack.com
# Free tier: 100 requests/month. Schedule/status only, no prices.
AVIATIONSTACK_API_KEY=

# Optional: rotating proxy for Skyscanner or the Playwright scraper fallback.
# Format: http://user:pass@host:port
PROXY_URL=
